/**Workflow d'analyse RNA-seq sur banque de séquences paired**/

/**Définition des fichiers d'entrée**/

params.genome = "/path/to/fasta"
params.annotation = "/path/to/gff"
params.outdir = "/path/to/output"
params.reads = "/path/to/reads/*_{R1,R2}.fastq.gz"


/**paramètres des outils**/

params.option_star_index = "--genomeSAindexNbases 10"
params.option_star_mapping = "--readFilesCommand gunzip -c"
params.option_samtools = ""
params.option_bigwig = ""
params.option_feature_counts = "-T 16 -t mRNA -g ID "
params.option_rsem = " --paired-end -p 16 --alignments"

singularity {
	enabled = true
	autoMount = true
	runOptions = "--bind $baseDir/"
}

process {
	
		cpus = 16
	
		withLabel: 'indexation_genome_STAR|mapping_STAR' {
			container = "/path/to/star:2.7.8a--h9ee0642_1"
			}
		
		withLabel: 'index_samtools' {
			container = "/path/to/samtools:1.3.1--h1b8c3c0_8"
			}
			
		withLabel: 'bigwig' {
			container = "/path/to/deeptools:3.5.1--py_0"
			}	

		withLabel: 'feature_counts' {
			container = "/path/to/subread:2.0.1--hed695b0_0"
			}
		withLabel: 'rsem_index|rsem_calculate' {
			container = "/path/to/rsem.sif"
			}
}


