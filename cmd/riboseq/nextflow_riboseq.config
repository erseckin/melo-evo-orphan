/** Ribo-seq single-end configuration (STAR + RSEM only) **/

params.genome     = "/path/to/fasta"
params.annotation = "/path/to/gff"
params.reads      = "/path/to/reads*.fastq.gz"   // SINGLE-END 
params.outdir = "/path/to/output"

// STAR 
params.option_star_index   = "--genomeSAindexNbases 10 --limitGenomeGenerateRAM 35000000000"
params.option_star_mapping = "--readFilesCommand gunzip -c --outFilterMismatchNmax 2 --outFilterMatchNmin 16 --alignEndsType EndToEnd --alignIntronMax 1"

// RSEM 
params.option_rsem = "-p 16 --alignments"

singularity {
  enabled   = true
  autoMount = true
  // bind both project base and /work to avoid node/partition surprises
  runOptions = "--bind $baseDir/,/work"
}

process {
  cpus = 16

  withLabel: 'indexation_genome_STAR|mapping_STAR' {
    container = "/path/to/star:2.7.8a--h9ee0642_1"
  }
  withLabel: 'rsem_index|rsem_calculate' {
    container = "/path/to/rsem.sif"
  }
}

